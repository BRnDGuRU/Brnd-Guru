# Agent 1 — n8n stack environment. Copy to `.env` (gitignored) and fill in.
# Generate the encryption key once: openssl rand -hex 24

N8N_HOST=n8n.fedgovstartup.com
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Passed through to the workflow HTTP nodes
GHL_LOCATION_ID=
ZOOM_ACCOUNT_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=
