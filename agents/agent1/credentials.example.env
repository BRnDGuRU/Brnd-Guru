# Agent 1 — credentials template
# Copy this file to `credentials.env` (gitignored) and fill in real values.
# NEVER commit credentials.env. Rotate any password that has been shared in plaintext.

# ── GoHighLevel ───────────────────────────────────────────────
GHL_LOGIN_URL=https://app.gohighlevel.com
GHL_LOGIN_EMAIL=
GHL_LOGIN_PASSWORD=
GHL_LOCATION_ID=
GHL_API_KEY=            # Settings > Integrations > API Key (Location-level)
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# ── Zoom (Server-to-Server OAuth app) ─────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_API_BASE=https://api.zoom.us/v2

# ── Calendly ──────────────────────────────────────────────────
CALENDLY_BOOKING_URL=https://calendly.com/randy-wimmer/30-minute-zoom-mtg-with-randy
CALENDLY_PAT=          # Personal Access Token (Integrations > API & Webhooks)

# ── n8n ───────────────────────────────────────────────────────
N8N_BASE_URL=          # e.g. https://n8n.fedgovstartup.com
N8N_WEBHOOK_ADMIN_FORM=/webhook/update-webinar
N8N_WEBHOOK_CALENDLY=/webhook/calendly

# ── Email (from address on verified domain) ───────────────────
FROM_EMAIL=randy@fedgovstartup.com
FROM_NAME=Randy Wimmer — Government Contracting Academy
NOTIFY_EMAIL=randy.wimmer@gmail.com   # internal notification recipient
